# Makefile for python interface for package pyexcelize.
# File is generated by gopy. Do not edit.
# gopy build --output=py_excelize -vm=python3 ./pkg/pyexcelize

GOCMD=go
GOBUILD=$(GOCMD) build -mod=mod
GOIMPORTS=goimports
PYTHON=/home/adhadse/uv_environments/env_lightning/bin/python3
LIBEXT=.so

# get the CC and flags used to build python:
GCC = $(shell $(GOCMD) env CC)
# detect python compile flags dynamically for current system python
PYTHON_CONFIG ?= $(shell command -v python3-config || command -v python3.13-config || command -v python3.12-config)
CFLAGS = $(shell $(PYTHON_CONFIG) --includes)
# Python 3.8+ requires --embed to get -lpythonX flags from python3-config
LDFLAGS = $(shell $(PYTHON_CONFIG) --embed --ldflags 2>/dev/null || $(PYTHON_CONFIG) --ldflags)
# ensure the runtime can find the Go shim next to the extension
RPATH = -Wl,-rpath,'$$ORIGIN'

all: gen build

gen:
	# generate bindings only; we'll build ourselves to inject fixes
	gopy gen --output=py_excelize -vm=python3 -rename ./pkg/pyexcelize

regen: clean gen build
build:
	# build the generated files
	# fix conflicting typedef introduced by generator on some platforms
	# replace 'typedef uint8_t bool;' with a portable include once per regen
	@if grep -q '^typedef uint8_t bool;' py_excelize/pyexcelize.go; then \
		sed -i 's|^typedef uint8_t bool;$$|#include <stdint.h>|' py_excelize/pyexcelize.go; \
	fi
	# goimports is needed to ensure that the imports list is valid
	$(GOIMPORTS) -w py_excelize/pyexcelize.go
	# generate pyexcelize_go$(LIBEXT) from pyexcelize.go -- the cgo wrappers to go functions
	$(GOBUILD) -buildmode=c-shared -o py_excelize/pyexcelize_go$(LIBEXT) py_excelize/pyexcelize.go
	# use pybindgen to build the pyexcelize.c file which are the CPython wrappers to cgo wrappers..
	# note: pip install pybindgen to get pybindgen if this fails
	cd py_excelize && $(PYTHON) build.py
	# build the _pyexcelize$(LIBEXT) library that contains the cgo and CPython wrappers
	# generated pyexcelize.py python wrapper imports this c-code package
	$(GCC) py_excelize/pyexcelize.c -Lpy_excelize -Wl,--no-undefined -Wl,--as-needed -l:pyexcelize_go$(LIBEXT) -o py_excelize/_pyexcelize$(LIBEXT) $(CFLAGS) $(LDFLAGS) $(RPATH) -fPIC --shared -w
	# write __init__.py that preloads Go shim and re-exports API
	@printf "%s\n" \
	"import os, ctypes" \
	"" \
	"_pkg_dir = os.path.dirname(os.path.abspath(__file__))" \
	"_go_shim = os.path.join(_pkg_dir, 'pyexcelize_go.so')" \
	"try:" \
	"    if os.path.exists(_go_shim):" \
	"        ctypes.CDLL(_go_shim, mode=getattr(ctypes, 'RTLD_GLOBAL', 0))" \
	"except OSError:" \
	"    pass" \
	"" \
	"from . import _pyexcelize" \
	"from .pyexcelize import *" \
	> py_excelize/__init__.py
	

clean:
	rm -f py_excelize/_pyexcelize$(LIBEXT) py_excelize/pyexcelize_go$(LIBEXT) py_excelize/pyexcelize.c



